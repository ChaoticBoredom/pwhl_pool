json.boxes do
  json.array! @result do |box|
    json.name box[:name]
    json.position box[:position]

    json.players do
      json.array! box[:players] do |player|
        json.partial! partial: "commissioner/pool_boxes/box_player", locals: { player: player }
      end
    end
  end
end

json.free_agents do
  json.array! @free_agents do |player|
    json.partial! partial: "commissioner/pool_boxes/box_player", locals: { player: player }
  end
end

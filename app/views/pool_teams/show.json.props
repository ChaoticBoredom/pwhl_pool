json.id @pool_team.id
json.team_name @pool_team.team_name
json.total_score @total_score
json.pool_id @pool.id
json.trade_state @pool.trade_policy_result
json.games_active @pool.league.games_active?

json.owner do
	json.id @pool_team.owner.id
	json.name @pool_team.owner.name
end

json.current_team do
  json.array! @current_team do |tp|
    player = tp.league_player
    summary = @player_summaries[tp.id]
    
    json.id tp.id
    json.partial! partial: "players/player", locals: { player: player, id_field: "league_player_id" }
    json.added_at tp.added_at
    json.pool_box_position tp.pool_box.position

    json.scores do
      json.pool_score summary[:pool_score]
      json.partial! partial: 'players/scores', locals: { scores: summary[:scores], clipped: summary[:clipped_scores] }
    end

    json.games do
      upcoming = @player_games[tp.id][:upcoming]
      today = @player_games[tp.id][:today]

      json.upcoming do
        json.id upcoming.id unless upcoming.nil?
      end

      json.today do
        json.id today.id unless today.nil?
      end
    end
  end
end

json.previous_team do
  json.array! @previous_team do |tp|
    player = tp.league_player
    summary = @player_summaries[tp.id]
    
    json.id tp.id
    json.partial! partial: "players/player", locals: { player: player, id_field: "league_player_id" }
    json.added_at tp.added_at
    json.dropped_at tp.dropped_at

    json.scores do
      json.pool_score summary[:pool_score]
      json.partial! partial: 'players/scores', locals: { scores: summary[:scores], clipped: summary[:clipped_scores] }
    end
  end
end
